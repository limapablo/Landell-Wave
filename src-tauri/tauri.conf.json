{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Landell Wave",
  "version": "0.1.0",
  "identifier": "io.github.limapablo.landellwave",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Landell Wave",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src https: http:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Music",
    "publisher": "Pablo Lima",
    "copyright": "Copyright © 2026 Pablo Lima",
    "shortDescription": "Open global internet radio directory",
    "longDescription": "Landell Wave is an open-source worldwide internet radio directory organized by country, region and city.",
    "homepage": "https://github.com/limapablo/Landell-Wave",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Landell Wave"
      }
    }
  }
}
